    async def _select_profile_gender_homme(self, scope: Locator | Page) -> None:
        # MesLibertines uses a custom radio: the native input is hidden inside
        # span.mcf-fake-radio. Select the exact observed semantic value instead
        # of relying on visibility or visual position.
        homme = scope.locator('input[type="radio"][name="data[gender]"][value="m"]')
        if await homme.count() == 1:
            radio = homme.first
            try:
                if await radio.is_checked():
                    return
            except Exception:
                pass

            # Observed on the live site: clicking the hidden native input itself
            # does NOT toggle checked. The site's mcf-radio widget listens on the
            # visible parent span.mcf-fake-radio. Click that wrapper first.
            try:
                wrapper = radio.locator("xpath=parent::*[contains(concat(' ', normalize-space(@class), ' '), ' mcf-fake-radio ')]")
                if await wrapper.count() == 1:
                    await wrapper.first.click(timeout=3_000)
                    await radio.page.wait_for_timeout(150)
                    if await radio.is_checked():
                        return
            except Exception:
                pass

            # Fallback: dispatch the same DOM click on the parent wrapper. This is
            # useful if the wrapper is technically present but Playwright considers
            # it non-actionable due to legacy layout/CSS.
            try:
                await radio.evaluate("el => el.parentElement && el.parentElement.click()")
                await radio.page.wait_for_timeout(150)
                if await radio.is_checked():
                    return
            except Exception:
                pass

            # Last-resort compatibility path. Never continue unless checked=true.
            try:
                await radio.check(force=True)
                if await radio.is_checked():
                    return
            except Exception:
                pass

        raise ManualIntervention(
            "Não consegui selecionar Je suis = homme com segurança (esperado data[gender]=m)."
        )

    async def _profile_gender_is_homme(self, scope: Locator | Page) -> bool:
        try:
            homme = scope.locator('input[type="radio"][name="data[gender]"][value="m"]')
            if await homme.count() == 1 and await homme.first.is_checked():
                return True
        except Exception:
            pass

        try:
            loc = scope.get_by_label(re.compile(r"^\s*homme\s*$", re.I))
            for i in range(await loc.count()):
                item = loc.nth(i)
                if await item.is_visible() and await item.is_checked():
                    return True
        except Exception:
            pass

        radios = scope.locator('input[type="radio"]:visible')
        for i in range(await radios.count()):
            radio = radios.nth(i)
            meta = await self._element_meta(radio, ("value", "name", "id", "title", "aria-label"))
            if ("homme" in meta or re.search(r"(?:^|\s)male(?:\s|$)", meta)) and await radio.is_checked():
                return True

        if await radios.count() == 4:
            try:
                page_text = (await self._scope_inner_text(scope)).lower()
                if all(word in page_text for word in ("homme", "femme", "couple", "trans")):
                    return await radios.nth(0).is_checked()
            except Exception:
                pass
        return False

    async def _find_profile_city_input(self, scope: Locator | Page) -> Locator | None:
        for pattern in (r"^\s*Ville\s*: ?$", r"^\s*Ville\s*$", r"City"):
            loc = scope.get_by_label(re.compile(pattern, re.I))
            for i in range(await loc.count()):
                item = loc.nth(i)
                try:
                    if await item.is_visible():
                        return item
                except Exception:
                    pass

        inputs = scope.locator('input[type="text"]:visible, input[type="search"]:visible, input:not([type]):visible')
        for i in range(await inputs.count()):
            item = inputs.nth(i)
            meta = await self._element_meta(item, ("name", "id", "placeholder", "title", "aria-label"))
            if "ville" in meta or "city" in meta:
                return item

        # Geometry fallback for legacy labels without a for= attribute.
        labels = scope.get_by_text(re.compile(r"^\s*Ville\s*: ?$", re.I), exact=True)
        label_box = None
        for i in range(await labels.count()):
            item = labels.nth(i)
            try:
                if await item.is_visible():
                    label_box = await item.bounding_box()
                    if label_box:
                        break
            except Exception:
                pass
        if label_box:
            best = None
            best_distance = 10_000.0
            for i in range(await inputs.count()):
                item = inputs.nth(i)
                box = await item.bounding_box()
                if not box:
                    continue
                dx = max(0.0, box["x"] - (label_box["x"] + label_box["width"]))
                dy = abs((box["y"] + box["height"] / 2) - (label_box["y"] + label_box["height"] / 2))
                distance = dx + dy
                if distance < best_distance and dy < 60:
                    best = item
                    best_distance = distance
            if best is not None:
                return best
        return None

    async def _select_profile_city(self, page: Page, scope: Locator | Page, city: str) -> str:
        city_input = await self._find_profile_city_input(scope)
        if city_input is None:
            raise ManualIntervention("Campo Ville não encontrado.")

        original = unicodedata.normalize("NFC", (city or "").strip())
        if not original:
            raise ManualIntervention("Cidade do membro está vazia.")

        fallback = self.normalize_city_for_search(original)

        # Primeira tentativa: nome original exato, preservando acentos, cedilha e hífens.
        searches = [original]
        if fallback and fallback.lower() != original.lower():
            searches.append(fallback)

        for search_value in searches:
            await city_input.click()
            await city_input.fill("")
            await city_input.type(search_value, delay=65)

            input_box = await city_input.bounding_box()
            if not input_box:
                raise ManualIntervention("Não consegui localizar visualmente o campo Ville.")

            for _ in range(48):  # ~12s para autocomplete lento
                await page.wait_for_timeout(250)

                # Diagnóstico temporário do autocomplete enquanto a lista está aberta.
                try:
                    debug_rows = await page.locator("body *").evaluate_all(
                        '''els => els
                            .filter(el => {
                                const style = window.getComputedStyle(el);
                                const rect = el.getBoundingClientRect();
                                const text = (el.textContent || '').trim();
                                return text.includes("Besançon")
                                    && style.display !== "none"
                                    && style.visibility !== "hidden"
                                    && rect.width > 0
                                    && rect.height > 0;
                            })
                            .map(el => ({
                                tag: el.tagName,
                                id: el.id || "",
                                className: typeof el.className === "string" ? el.className : "",
                                role: el.getAttribute("role") || "",
                                text: (el.textContent || "").trim(),
                                parentTag: el.parentElement?.tagName || "",
                                parentId: el.parentElement?.id || "",
                                parentClass: typeof el.parentElement?.className === "string"
                                    ? el.parentElement.className
                                    : "",
                                outerHTML: el.outerHTML.slice(0, 1200),
                                parentHTML: el.parentElement
                                    ? el.parentElement.outerHTML.slice(0, 1800)
                                    : ""
                            }))'''
                    )

                    if debug_rows:
                        from pathlib import Path as _DebugPath
                        import json as _json

                        _DebugPath("logs").mkdir(exist_ok=True)
                        _DebugPath("logs/ville_debug.txt").write_text(
                            _json.dumps(debug_rows, ensure_ascii=False, indent=2),
                            encoding="utf-8"
                        )

                        _DebugPath("logs/ville_debug.html").write_text(
                            await page.content(),
                            encoding="utf-8"
                        )
                except Exception:
                    pass

                # Containers comuns de autocomplete + elementos destacados.
                raw_candidates = page.locator(
                    'li:visible, '
                    '[role="option"]:visible, '
                    '.autocomplete-suggestion:visible, '
                    '.ui-menu-item:visible, '
                    '.ac_results li:visible, '
                    '.autocomplete-suggestions > div:visible, '
                    'strong:visible, b:visible'
                )

                best = None
                best_text = None
                best_distance = 10_000.0

                for i in range(await raw_candidates.count()):
                    item = raw_candidates.nth(i)

                    try:
                        text_value = (
                            await item.evaluate(
                                "(el) => (el.textContent || el.innerText || '').trim()"
                            )
                        )
                    except Exception:
                        continue

                    if not text_value:
                        continue

                    # Compara tanto de forma exata quanto normalizada.
                    exact_match = (
                        unicodedata.normalize("NFC", text_value).strip().casefold()
                        == original.casefold()
                    )

                    normalized_match = (
                        self.normalize_city_for_search(text_value)
                        == self.normalize_city_for_search(original)
                    )

                    if not (exact_match or normalized_match):
                        continue

                    # Se o texto está em <strong>/<b>, sobe até um container clicável.
                    candidate = item
                    try:
                        candidate = item.locator(
                            "xpath=ancestor-or-self::*[self::li or @role='option' "
                            "or contains(@class,'autocomplete') "
                            "or contains(@class,'ui-menu-item')][1]"
                        )
                        if await candidate.count() == 0:
                            candidate = item
                    except Exception:
                        candidate = item

                    try:
                        box = await candidate.bounding_box()
                    except Exception:
                        box = None

                    if not box:
                        continue

                    input_bottom = input_box["y"] + input_box["height"]
                    vertical = box["y"] - input_bottom

                    horizontal_overlap = (
                        box["x"] < input_box["x"] + input_box["width"] + 250
                        and box["x"] + box["width"] > input_box["x"] - 80
                    )

                    if not horizontal_overlap or vertical < -10 or vertical > 500:
                        continue

                    distance = abs(vertical) + abs(box["x"] - input_box["x"]) * 0.1

                    # Correspondência exata tem prioridade máxima.
                    if exact_match:
                        distance -= 500

                    if distance < best_distance:
                        best = candidate
                        best_distance = distance
                        best_text = text_value

                if best is not None:
                    try:
                        await best.click()
                    except Exception:
                        try:
                            await best.evaluate("(el) => el.click()")
                        except Exception:
                            continue

                    await page.wait_for_timeout(500)

                    current = (await city_input.input_value()).strip()

                    # Aceita o valor se corresponder à cidade original
                    # ou à sua forma normalizada.
                    if (
                        unicodedata.normalize("NFC", current).casefold()
                        == original.casefold()
                        or self.normalize_city_for_search(current)
                        == self.normalize_city_for_search(original)
                    ):
                        return best_text or current

            # Se a primeira tentativa falhou, o loop segue para o fallback.

        raise ManualIntervention(
            f"Autocomplete de Ville não ofereceu correspondência segura para '{original}'. "
            f"Tentativas: {searches!r}."
        )

    async def _scope_inner_text(self, scope: Locator | Page) -> str:
        if isinstance(scope, Page):
            return await scope.locator("body").inner_text()
        return await scope.inner_text()

    async def _element_meta(self, loc: Locator, attrs: tuple[str, ...]) -> str:
        parts: list[str] = []
        for attr in attrs:
            parts.append(await loc.get_attribute(attr) or "")
        return " ".join(parts).lower()

    async def _detect_protection(self, page: Page) -> None:
        try:
            text = (await page.locator("body").inner_text()).lower()
        except Exception:
            return

        suspicious = [
            "captcha",
            "cloudflare",
            "too many requests",
            "rate limit",
            "verify you are human",
            "vérifiez que vous êtes humain",
            "verifiez que vous etes humain",
            "access denied",
        ]
        for marker in suspicious:
            if marker in text:
                raise ManualIntervention(f"Proteção/verificação detectada: {marker}")
