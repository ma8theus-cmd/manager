    async def _is_logged_in(self, page: Page, username: str) -> bool:
        try:
            text = (await page.locator("body").inner_text()).lower()
        except Exception:
            return False
        normalized_user = (username or "").lower()
        has_private_marker = (
            "dans votre espace privé" in text
            or "dans votre espace prive" in text
            or "déconnexion" in text
            or "deconnexion" in text
        )
        return has_private_marker and (normalized_user in text or "déconnexion" in text or "deconnexion" in text)

    async def logout_member(self, page: Page, member: dict) -> None:
        """Log out after profile validation and confirm that the authenticated session ended."""
        # A late +18 popup can also obstruct the account menu.
        await self.accept_initial_age_gate(page, member["birth_date"], wait_ms=2_500)

        if not await self._is_logged_in(page, member["username"]):
            return

        async def find_logout() -> Locator | None:
            patterns = (
                r"^\s*Déconnexion\s*$",
                r"^\s*Deconnexion\s*$",
                r"^\s*Déconnexion\s+.+$",
                r"^\s*Deconnexion\s+.+$",
            )
            for pattern in patterns:
                loc = page.get_by_text(re.compile(pattern, re.I), exact=True)
                for i in range(await loc.count()):
                    item = loc.nth(i)
                    try:
                        if await item.is_visible():
                            return item
                    except Exception:
                        pass
            links = page.locator("a:visible")
            for i in range(await links.count()):
                item = links.nth(i)
                try:
                    text = (await item.inner_text()).strip()
                except Exception:
                    continue
                if re.match(r"^\s*d[ée]connexion(?:\s|$)", text, re.I):
                    return item
            return None

        logout = await find_logout()
        if logout is None:
            # On the observed UI the logout action can be inside the MON PROFIL
            # hover menu. Hover once and look again.
            menu = page.get_by_text(re.compile(r"MON\s+PROFIL", re.I))
            best_menu = None
            best_len = 10_000
            for i in range(await menu.count()):
                item = menu.nth(i)
                try:
                    if not await item.is_visible():
                        continue
                    label = (await item.inner_text()).strip()
                    if "mon profil" not in label.lower():
                        continue
                    if len(label) < best_len:
                        best_menu = item
                        best_len = len(label)
                except Exception:
                    pass
            if best_menu is not None:
                try:
                    await best_menu.hover()
                    await page.wait_for_timeout(700)
                except Exception:
                    pass
            logout = await find_logout()

        if logout is None:
            raise ManualIntervention("Perfil validado, mas a opção Déconnexion não foi encontrada.")

        await logout.click()
        try:
            await page.wait_for_load_state("domcontentloaded", timeout=12_000)
        except Exception:
            pass

        # Confirm logout without requiring the login button to be visible; a
        # post-logout +18 popup may cover it. The important condition is that
        # the private/logged-in markers disappear.
        for _ in range(40):
            await page.wait_for_timeout(300)
            if not await self._is_logged_in(page, member["username"]):
                return

        raise ManualIntervention("Déconnexion foi acionado, mas a sessão continuou autenticada.")

    async def open_profile_editor(self, page: Page, member: dict) -> Locator | Page:
        await self.accept_initial_age_gate(page, member["birth_date"], wait_ms=1_000)

        for attempt in range(2):
            links = page.get_by_text(re.compile(r"^\s*Modifier le profil\s*$", re.I), exact=True)
            for i in range(await links.count()):
                item = links.nth(i)
                try:
                    if await item.is_visible():
                        await item.click()
                        try:
                            await page.wait_for_load_state("domcontentloaded", timeout=15_000)
                        except Exception:
                            pass
                        await page.wait_for_timeout(700)
                        await self.accept_initial_age_gate(page, member["birth_date"], wait_ms=1_500)
                        await self._detect_protection(page)
                        scope = await self._profile_scope(page)
                        if scope is not None:
                            return scope
                except Exception:
                    pass

            # Fallback: hover MON PROFIL to reveal the menu, then retry.
            menu = page.get_by_text(re.compile(r"^\s*MON PROFIL\s*$", re.I), exact=True)
            hovered = False
            for i in range(await menu.count()):
                item = menu.nth(i)
                try:
                    if await item.is_visible():
                        await item.hover()
                        hovered = True
                        await page.wait_for_timeout(500)
                        break
                except Exception:
                    pass
            if not hovered:
                break

        raise ManualIntervention("Não foi possível abrir Modifier le profil.")

