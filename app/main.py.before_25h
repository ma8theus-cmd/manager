\
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

from fastapi import FastAPI, Request
from fastapi.responses import RedirectResponse
from fastapi.templating import Jinja2Templates

from .config import settings
from .database import init_db
from .services import (
    dashboard_data,
    mark_account_created,
    mark_email_confirmed,
    reserve_daily_batch,
    reset_to_pending,
)

app = FastAPI(title="MesLibertines Manager")
templates = Jinja2Templates(directory=str(settings.project_root / "app" / "templates"))


@app.on_event("startup")
def startup():
    init_db()


@app.get("/")
def dashboard(request: Request, msg: str | None = None, error: str | None = None):
    data = dashboard_data()
    return templates.TemplateResponse(
        "dashboard.html",
        {
            "request": request,
            "data": data,
            "msg": msg,
            "error": error,
        },
    )


@app.post("/prepare-batch")
def prepare_batch():
    try:
        ids = reserve_daily_batch()
        if not ids:
            return RedirectResponse(
                "/?msg=Nenhuma+vaga+disponivel+no+lote+de+hoje",
                status_code=303,
            )

        script = settings.project_root / "scripts" / "prepare_batch.py"
        cmd = [sys.executable, str(script), "--ids", *[str(i) for i in ids]]

        env = os.environ.copy()
        # Preserva DISPLAY/WAYLAND_DISPLAY da sessão gráfica da VPS.
        subprocess.Popen(
            cmd,
            cwd=str(settings.project_root),
            env=env,
            start_new_session=True,
        )

        return RedirectResponse(
            f"/?msg=Lote+reservado:+{','.join(map(str, ids))}.+O+Chromium+sera+aberto.",
            status_code=303,
        )
    except Exception as exc:
        return RedirectResponse(f"/?error={str(exc)}", status_code=303)


@app.post("/members/{member_id}/account-created")
def account_created(member_id: int):
    try:
        mark_account_created(member_id)
        return RedirectResponse("/?msg=Conta+marcada+como+criada", status_code=303)
    except Exception as exc:
        return RedirectResponse(f"/?error={str(exc)}", status_code=303)


@app.post("/members/{member_id}/email-confirmed")
def email_confirmed(member_id: int):
    try:
        mark_email_confirmed(member_id)
        return RedirectResponse("/?msg=Email+confirmado", status_code=303)
    except Exception as exc:
        return RedirectResponse(f"/?error={str(exc)}", status_code=303)


@app.post("/members/{member_id}/reset")
def reset_member(member_id: int):
    try:
        reset_to_pending(member_id)
        return RedirectResponse("/?msg=Membro+voltou+para+PENDING", status_code=303)
    except Exception as exc:
        return RedirectResponse(f"/?error={str(exc)}", status_code=303)


@app.get("/health")
def health():
    return {"ok": True}
